#!/bin/bash
# Zero-Optimize privileged system helper
# Performs root-level memory optimization without killing user processes:
# 1. sync filesystem buffers
# 2. drop slab caches and inode buffers (/proc/sys/vm/drop_caches)
# 3. compact memory pages (/proc/sys/vm/compact_memory)
# 4. compact zram in-memory compressed blocks (/sys/block/zram0/compact)
# 5. trigger zram memory recompression (/sys/block/zram0/recompress)

set -e

ACTION="${1:-all}"

sync_and_drop_caches() {
    sync
    if [ -w /proc/sys/vm/drop_caches ]; then
        echo 3 > /proc/sys/vm/drop_caches
    fi
}

compact_memory() {
    if [ -w /proc/sys/vm/compact_memory ]; then
        echo 1 > /proc/sys/vm/compact_memory
    fi
}

compact_zram() {
    # Alleviates zram memory fragmentation and compresses stored swap pages tighter
    if [ -w /sys/block/zram0/compact ]; then
        echo 1 > /sys/block/zram0/compact 2>/dev/null || true
    fi
}

recompress_zram() {
    if [ -w /sys/block/zram0/recompress ]; then
        echo 1 > /sys/block/zram0/recompress 2>/dev/null || true
    fi
}

vacuum_journal() {
    if command -v journalctl >/dev/null 2>&1; then
        journalctl --vacuum-size=20M >/dev/null 2>&1 || true
    fi
}

case "$ACTION" in
    drop_caches)
        sync_and_drop_caches
        ;;
    compact)
        compact_memory
        compact_zram
        ;;
    journal)
        vacuum_journal
        ;;
    all)
        sync_and_drop_caches
        compact_memory
        compact_zram
        recompress_zram
        vacuum_journal
        ;;
    *)
        echo "Unknown action: $ACTION" >&2
        exit 1
        ;;
esac

exit 0
