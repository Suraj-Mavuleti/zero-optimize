#!/bin/bash
# Zero-Optimize privileged system helper
# Performs root-level memory optimization without killing user processes:
# 1. sync filesystem buffers
# 2. drop slab caches and inode buffers (/proc/sys/vm/drop_caches)
# 3. compact memory pages (/proc/sys/vm/compact_memory)
# 4. compact zram in-memory compressed blocks (/sys/block/zram0/compact)
# 5. trigger zram memory recompression (/sys/block/zram0/recompress)

set -e

ACTION="${1:-all}"

sync_and_drop_caches() {
    sync
    if [ -w /proc/sys/vm/drop_caches ]; then
        echo 3 > /proc/sys/vm/drop_caches
    fi
}

compact_memory() {
    if [ -w /proc/sys/vm/compact_memory ]; then
        echo 1 > /proc/sys/vm/compact_memory
    fi
}

compact_zram() {
    # Alleviates zram memory fragmentation and compresses stored swap pages tighter
    if [ -w /sys/block/zram0/compact ]; then
        echo 1 > /sys/block/zram0/compact 2>/dev/null || true
    fi
}

recompress_zram() {
    if [ -w /sys/block/zram0/recompress ]; then
        echo 1 > /sys/block/zram0/recompress 2>/dev/null || true
    fi
}

vacuum_journal() {
    if command -v journalctl >/dev/null 2>&1; then
        journalctl --vacuum-size=20M >/dev/null 2>&1 || true
    fi
}

reclaim_cgroup_memory() {
    # Proactively forces cold/inactive anonymous pages into ZRAM swap without killing anything
    for r in /sys/fs/cgroup/user.slice/user-*.slice/memory.reclaim; do
        if [ -w "$r" ]; then
            echo "1G" > "$r" 2>/dev/null || true
        fi
    done
}

tune_kernel_vm() {
    # Dynamically tunes Linux VM parameters to prevent pagecache hoarding
    # 1. Increase VFS cache pressure to 300 so unused directory/inode caches are released immediately
    sysctl -w vm.vfs_cache_pressure=300 >/dev/null 2>&1 || true
    # 2. Lower dirty ratios so write buffers flush to disk early instead of tying up RAM
    sysctl -w vm.dirty_background_ratio=5 >/dev/null 2>&1 || true
    sysctl -w vm.dirty_ratio=10 >/dev/null 2>&1 || true
    # 3. Increase watermark scale factor so kswapd wakes early and steadily compresses cold pages
    sysctl -w vm.watermark_scale_factor=100 >/dev/null 2>&1 || true
}

ensure_sudoers() {
    if [ "$EUID" -eq 0 ] && [ ! -f /etc/sudoers.d/zero-optimize ]; then
        mkdir -p /etc/sudoers.d
        cat > /etc/sudoers.d/zero-optimize <<EOF
%wheel ALL=(ALL) NOPASSWD: /home/suraj/antigravity-projects/zero-optimize/helper/zero-optimize-root-helper
%wheel ALL=(ALL) NOPASSWD: /usr/local/bin/zero-optimize-root-helper
suraj ALL=(ALL) NOPASSWD: /home/suraj/antigravity-projects/zero-optimize/helper/zero-optimize-root-helper
suraj ALL=(ALL) NOPASSWD: /usr/local/bin/zero-optimize-root-helper
EOF
        chmod 0440 /etc/sudoers.d/zero-optimize 2>/dev/null || true
    fi
}

case "$ACTION" in
    drop_caches)
        sync_and_drop_caches
        ;;
    compact)
        compact_memory
        compact_zram
        reclaim_cgroup_memory
        tune_kernel_vm
        ;;
    journal)
        vacuum_journal
        ;;
    tune)
        tune_kernel_vm
        ;;
    all)
        ensure_sudoers
        tune_kernel_vm
        sync_and_drop_caches
        compact_memory
        compact_zram
        recompress_zram
        reclaim_cgroup_memory
        vacuum_journal
        ;;
    *)
        echo "Unknown action: $ACTION" >&2
        exit 1
        ;;
esac

exit 0
